{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "bar": {
            "char": { "elapsed": "■", "total": "─" },
            "width": 18
        },
        "percent": { "type": 2 }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "uptime",
        "packages",
        "break",

        "cpu",
        "gpu",
        "display", 
        "break",

        { "type": "cpuusage", "key": "CPU Load  " },
        { "type": "memory",   "key": "Memory    " },
        { "type": "disk",     "key": "Disk      ", "folders": "/" },
        { "type": "battery",  "key": "Battery   " },
        { 
            "type": "poweradapter", 
            "key": "Power     ", 
            "format": "{1}W {2} ({3})" 
        },
        "break",

        "wifi",
        "localip",
        "publicip",
        "break"
    ]
}